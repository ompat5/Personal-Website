---
const companies = [
  {
    name: "Synopsys",
    roles: [
      {
        title: "Data Scientist Intern",
        date: "May 2025 — Dec 2025",
        points: [
          "Built an in-platform data transformation engine in Qt, cutting analysis time by 20% by removing manual import/export steps.",
          "Added predictive modeling support with scikit-learn to streamline experiment workflows end-to-end.",
        ],
      },
    ],
  },
  {
    name: "Ontario Ministry of Education",
    roles: [
      {
        title: "Data Scientist Intern",
        date: "Sept 2024 — Dec 2024",
        points: [
          "Automated a Pandas pipeline that cut preprocessing time for 300K+ planning records from an hour down to seconds.",
          "Led schema and impact-analysis work in dbt to support future housing policy decisions.",
        ],
      },
    ],
  },
  {
    name: "Darwin CX",
    roles: [
      {
        title: "Data Scientist Intern",
        date: "Sept 2023 — Apr 2024",
        points: [
          "Used K-Means clustering to improve seasonal forecasting accuracy by 30%",
          "Optimized Snowflake and Looker infrastructure to cut report load times by 98%.",
          "Built medallion-architecture pipelines in dbt for the team's core data models.",
        ],
      },
      {
        title: "Data Analyst Intern",
        date: "Apr 2023 — Sept 2023",
        points: [
          "Built 20+ Looker reports and streamlined SQL-based audits, cutting resolution time in half.",
        ],
      },
    ],
  },
  {
    name: "Ontario Ministry of Transportation",
    roles: [
      {
        title: "Data Analyst Intern",
        date: "Sept 2022 — Dec 2022",
        points: [
          "Created Power BI dashboards on IT application usage to support organizational decision-making.",
        ],
      },
    ],
  },
